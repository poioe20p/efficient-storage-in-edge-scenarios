# RQ2 v4 scaling-mode delta — compute-only (storage scale-up blocked).
# Merge over current_state_integrated.env via rq2v4_launch_run.sh; see
# rq2v4_mode_both.env for the merge contract.
# Comp also disables the persistent storage reserve so no storage-side spawn
# path escapes the ablation (preparation.md D1/D8).
MAX_DYNAMIC_COMPUTE=6
MAX_DYNAMIC_STORAGE=0
STORAGE_PERSISTENT_RESERVE_ENABLED=0
SS_ENABLED=0
