# RQ2 v4 scaling-mode delta — no-action comparator.
# Merge over current_state_integrated.env via rq2v4_launch_run.sh; see
# rq2v4_mode_both.env for the merge contract.
# Both tiers blocked plus the storage reserve off: the controller may observe
# and decide but can spawn nothing.
MAX_DYNAMIC_COMPUTE=0
MAX_DYNAMIC_STORAGE=0
STORAGE_PERSISTENT_RESERVE_ENABLED=0
SS_ENABLED=0
