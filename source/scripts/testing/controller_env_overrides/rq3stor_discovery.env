# RQ3 v3 storage-replica benefit — discovery (telemetry SECONDARY) arm env
# Distinct named regime (storage-replica readiness under a read-write mix),
# allowed by the canonical-env rule. See
# docs/operation/testing/experiment/v3/rq3/experiment_plan.md.
# Compute readiness gate is OFF (immediate compute registration) so only the
# storage promotion path carries the treatment.
STORAGE_PERSISTENT_RESERVE_ENABLED=0
SS_ENABLED=0
CROSS_REGION_STORAGE_ENABLED=0
TELEMETRY_SOURCE=event_preserving
SCALEUP_POLICY=dual
MAX_DYNAMIC_COMPUTE=12
# 48-client regime: Mongo pool 6 for dynamic edge servers (RQ3-sat precedent).
EDGE_MONGO_MAX_POOL_SIZE=6
READINESS_PROPAGATION=off
# RQ3 v3 storage propagation: promote ONLY on telemetry-detected SECONDARY
# (periodic discovery; quantization = telemetry cadence).
STORAGE_PROPAGATION=discovery
# RQ3 v3 read offload: route storage READS to secondaries (skip the primary).
STORAGE_READ_POLICY=prefer_secondary
DISCOVERY_POLL_INTERVAL_S=10.0
ADMISSION_LOG_PATH=/tmp/admission_log.csv
VIP_FLOW_ISOLATION=1
VIP_SERVER_PER_CONNECTION_FLOWS=1
FLOW_ISOLATION_WARMUP_S=120.0
EDGE_APP_READY_EVENT=0
EDGE_FLOW_ISOLATION=1
BACKEND_SELECTION_POLICY=topology_host
VIP_WARM_SERVER_SECONDS=0
VIP_WARM_STORAGE_SECONDS=30
W_CPU=0.2
W_RAM=0.2
W_REQUESTS=0.2
W_HOPS=0.28
W_STORAGE_CPU=0.2
W_STORAGE_RAM=0.2
W_STORAGE_CONNECTIONS=0.1
W_STORAGE_LAG=0.2
W_STORAGE_HOPS=0.3
VIP_IDLE_TIMEOUT=30
VIP_HARD_TIMEOUT=120
CONTROL_TICK_S=10
DELAY_S=30
EVENT_POLL_INTERVAL_S=0.5
DELIVERY_LOG_PATH=/tmp/telemetry_delivery_log.csv
DECISION_LOG_PATH=/tmp/decision_log.csv
