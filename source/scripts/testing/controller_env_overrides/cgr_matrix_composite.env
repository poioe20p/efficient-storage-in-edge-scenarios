# TEMPORARY run-matrix env — Arm A: COMPOSITE storage signal (control-group
# redesign candidate, 2026-08-03). DELETED after the winning config is folded
# into current_state_integrated.env.
# Storage scale-up score = 0.6*cpu_component + 0.4*median-latency_component.
# Rationale: the pure-latency median under-provisions storage in the plateau
# (concurrent p50 2.0 vs mean-era 3.31; plateau error 12-17% vs 1.31%) because
# the median's plateau/demand_drop dynamic range is only ~1.4 ms. Storage CPU is
# bounded (robust — no tail contamination) and differentiates cleanly
# (plateau p50 44-47% / p90 73-79% vs demand_drop ~18%).
# Scale-down is CPU-aware: below = stCpu<22 AND med_db<8 -> plateau (stCpu ~30-44)
# is protected; demand_drop (stCpu 18, med_db 2.6) reclaims.
LATENCY_SIGNAL_MODE=median
STORAGE_PERSISTENT_RESERVE_ENABLED=1
SS_ENABLED=1
MAX_DYNAMIC_STORAGE=3
MAX_DYNAMIC_COMPUTE=3
SCALEUP_STORAGE_BASE_THRESHOLD=0.35
SCALEUP_COMPUTE_BASE_THRESHOLD=0.18
SCALEUP_CPU_FLOOR=10
SCALEUP_CPU_SPAN=40
SCALEUP_T_PROC_FLOOR=25
SCALEUP_W_CPU=0.60
SCALEUP_W_T_PROC=0.40
SCALEDOWN_COMPUTE_COOLDOWN_S=180
SCALE_DOWN_COMPUTE_REQUIRED=9
SCALEDOWN_STORAGE_COOLDOWN_S=30
SCALE_DOWN_STORAGE_WINDOW_SIZE=5
SCALE_DOWN_STORAGE_REQUIRED=3
# ── COMPOSITE storage signal (Arm A) ──
# CPU floor 10 / span 30: plateau stCpu 44% -> component saturates (~1.0) so the
# score ~0.65 clears the FULL adaptive threshold range (0.35/0.45/0.50/0.55 at
# 0..3 nodes) -> can reach the 3-node cap (review fix, d50dd04+).
SCALEUP_W_STORAGE_CPU=0.60
SCALEUP_W_T_DB=0.40
SCALEUP_STORAGE_CPU_FLOOR=10
SCALEUP_STORAGE_CPU_SPAN=30
SCALEUP_T_DB_FLOOR=10
SCALEUP_T_DB_SPAN=50
TAU_DB_DOWN_MS=8
STORAGE_SCALE_DOWN_CPU_AWARE=1
TAU_STORAGE_CPU_DOWN=22
SCALEUP_STORAGE_REQUIRED=2
SCALEUP_STORAGE_WINDOW_SIZE=5
SCALEUP_STORAGE_COOLDOWN_S=120
VIP_HARD_TIMEOUT=60
