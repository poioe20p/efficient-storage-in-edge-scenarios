# Controller override — no-scale counterfactual ablation (verification V1b).
# Identical to current_state_integrated.env EXCEPT: compute scale-up, storage
# scale-up, and the persistent reserve are DISABLED (MAX_DYNAMIC_*=0,
# STORAGE_PERSISTENT_RESERVE_ENABLED=0). Tier1 selective-sync (SS_ENABLED=1)
# stays ON so the ablation isolates ONLY the capacity-adding mechanisms.
# All other thresholds/cooldowns/weights are identical to the integrated
# baseline. Purpose: confirm whether removing scale-up/reserve makes the system
# "clearly suffer" vs the V1 canonical run under the same workload.
# Unlisted knobs resolve from the base osken-controller.env (override semantics).
# 2026-08-03: LATENCY_SIGNAL_MODE=median (control-group reset) — signal mode
# identical to the scalable arm so the ablation isolates ONLY the capacity knobs.
LATENCY_SIGNAL_MODE=median
STORAGE_PERSISTENT_RESERVE_ENABLED=0
SS_ENABLED=1
MAX_DYNAMIC_STORAGE=0
MAX_DYNAMIC_COMPUTE=0
SCALEUP_STORAGE_BASE_THRESHOLD=0.35
# Compute scale-up overrides — recalibrated for mean-only signal + tighter CPUs
SCALEUP_COMPUTE_BASE_THRESHOLD=0.18
SCALEUP_CPU_FLOOR=10
SCALEUP_CPU_SPAN=40
SCALEUP_T_PROC_FLOOR=25
SCALEUP_W_CPU=0.60
SCALEUP_W_T_PROC=0.40
# Compute scale-down overrides (longer grace to sustain nodes)
SCALEDOWN_COMPUTE_COOLDOWN_S=180
SCALE_DOWN_COMPUTE_REQUIRED=9
# Storage scale-up — COMPOSITE signal (G0-v4 rebase; identical to
# current_state_integrated.env so the ablation isolates ONLY the capacity knobs)
SCALEUP_W_STORAGE_CPU=0.60
SCALEUP_W_T_DB=0.40
SCALEUP_STORAGE_CPU_FLOOR=10
SCALEUP_STORAGE_CPU_SPAN=30
SCALEUP_T_DB_FLOOR=10
SCALEUP_T_DB_SPAN=50
TAU_DB_DOWN_MS=8
STORAGE_SCALE_DOWN_CPU_AWARE=1
TAU_STORAGE_CPU_DOWN=22
SCALEUP_STORAGE_REQUIRED=2
SCALEUP_STORAGE_WINDOW_SIZE=5
SCALEUP_STORAGE_COOLDOWN_S=120
VIP_HARD_TIMEOUT=60
# 2026-08-03 data-path fix: identical read-preference to the scalable arm so
# the ablation isolates ONLY the capacity knobs (see
# read_preference_data_path_finding.md). Harmless on a single primary.
EDGE_MONGO_READ_PREFERENCE=secondaryPreferred
# 2026-08-03 Approach B: identical pool/per-connection config to the scalable
# arm so the ablation isolates ONLY the capacity knobs (see
# read_preference_data_path_finding.md). Harmless on a single primary.
VIP_DATA_PER_CONNECTION_FLOWS=1
EDGE_MONGO_MAX_POOL_SIZE=6
