# RQ3 robustness event_only arm delta. Merge over rq3sat_direct.env.
# FALLBACK_S=130 exceeds READINESS_PROBE_MAX_S=120, so the abandon branch at
# ~120 s always fires before any fallback probe: the fallback is inert and a
# lost app_ready event yields an abandoned backend (verified in Stage 0).
READINESS_EVENT_FALLBACK_S=130.0
