# Controller override for the RQ1 telemetry delivery-semantics campaign.
# NOTE: superseded by the per-arm regime files used by the RQ1 experiment
# (docs/operation/testing/experiment/v2/rq1/experiment_plan.md):
#   - rq1_event_preserving.env   (Arm A)
#   - rq1_delayed.env            (Arm B)
#   - rq1_latest_state.env       (Arm C)
# Those files additionally set the capacity overrides (MAX_DYNAMIC_COMPUTE=12,
# MAX_DYNAMIC_STORAGE=8) and SCALEDOWN_COMPUTE_COOLDOWN_S=60 that this file
# lacks. Keep this file only as a legacy base; do not use for runs.
TELEMETRY_SOURCE=event_preserving
DELAY_S=30
CONTROL_TICK_S=10
EVENT_POLL_INTERVAL_S=0.5
DELIVERY_LOG_PATH=/tmp/telemetry_delivery_log.csv
DECISION_LOG_PATH=/tmp/decision_log.csv

# RQ1 disables Tier 1 selective sync, persistent storage reserves, and
# cross-region storage placement (thesis §2) so they cannot confound the
# delivery-semantics comparison. The canonical baseline enables them.
STORAGE_PERSISTENT_RESERVE_ENABLED=0
SS_ENABLED=0
CROSS_REGION_STORAGE_ENABLED=0
