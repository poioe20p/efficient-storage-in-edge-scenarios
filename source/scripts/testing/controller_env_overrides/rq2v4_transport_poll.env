# RQ2 v4 delivery-transport delta — latest-state polling (RQ1 Arm C).
# Reused for the P1.4 RQ1-mode smoke set. POLL_INTERVAL_S is also passed as a
# make variable by the launcher (the build script forwards it as docker -e and
# it overrides the env-file value, per the RQ1 run_matrix note). Provenance:
# docs/operation/testing/experiment/v2/rq1/env/rq1_latest_state.env.
TELEMETRY_SOURCE=poll
POLL_INTERVAL_S=30
