# RQ2 v4 scaling-mode delta — dual ("compute and storage scaling").
# Merge over source/scripts/testing/controller_env_overrides/current_state_integrated.env
# (delta wins on duplicate keys) via source/scripts/testing/rq2v4_launch_run.sh.
# Never pass this file alone as OSKEN_ENV_OVERRIDE_FILE.
# Caps pin the v4 operating point (6/6 per domain; rq2v4_plan.md P1.1).
# SS_ENABLED=0 uniformly across modes: the Tier-1 surface is not evaluated in
# v4 RQ2 (preparation.md D8), and holding it off keeps `none` a true
# no-action comparator.
MAX_DYNAMIC_COMPUTE=6
MAX_DYNAMIC_STORAGE=6
SS_ENABLED=0
