# RQ3 v7 -- degradation_score (aggressive scale-down)
# Harder scale-up + aggressive scale-down with reserve-floor decoupling
# node_registry.py: can_scale_down_storage bypasses reserve when >2 dynamic storage per LAN

# -- Scale-up (harder: 7/10 windows, longer cooldowns, higher thresholds) --
SCALEUP_CPU_FLOOR=10
SCALEUP_CPU_SPAN=40
SCALEUP_T_PROC_FLOOR=25
SCALEUP_T_PROC_SPAN=80
SCALEUP_COMPUTE_BASE_THRESHOLD=0.30
SCALEUP_COMPUTE_THRESHOLD_INCREMENT=0.10
SCALEUP_COMPUTE_MAX_THRESHOLD=0.85
SCALEUP_WINDOW_SIZE=10
SCALEUP_REQUIRED=7
SCALEUP_COMPUTE_COOLDOWN_S=180
SCALEUP_COMPUTE_PEER_RELIEF=0.03
SCALEUP_COMPUTE_PEER_HEALTH_THRESHOLD=0.35
SCALEUP_STORAGE_CPU_FLOOR=1.5
SCALEUP_STORAGE_CPU_SPAN=5
SCALEUP_T_DB_FLOOR=60
SCALEUP_T_DB_SPAN=250
SCALEUP_STORAGE_BASE_THRESHOLD=0.35
SCALEUP_STORAGE_THRESHOLD_INCREMENT=0.10
SCALEUP_STORAGE_MAX_THRESHOLD=0.55
SCALEUP_STORAGE_WINDOW_SIZE=7
SCALEUP_STORAGE_REQUIRED=4
SCALEUP_STORAGE_COOLDOWN_S=180

# -- Scale-down (aggressive: 3/5 windows, 30s cooldowns, raised underutilization ceilings) --
TAU_CPU_DOWN=25
TAU_PROC_DOWN_MS=50
TAU_STORAGE_CPU_DOWN=25
TAU_DB_DOWN_MS=400
SCALEDOWN_COMPUTE_COOLDOWN_S=30
SCALE_DOWN_COMPUTE_WINDOW_SIZE=5
SCALE_DOWN_COMPUTE_REQUIRED=3
SCALEDOWN_STORAGE_COOLDOWN_S=60
SCALE_DOWN_STORAGE_WINDOW_SIZE=6
SCALE_DOWN_STORAGE_REQUIRED=4
SCALE_DOWN_CANDIDATE_MAX_STALENESS_S=60
# Ceilings (SCALE_DOWN_*_CEILING_MS) NOT overridden -- 5000ms default safe with CURL_MAX_TIME=30s

# -- Unchanged --
TELEMETRY_TIMEOUT_WINDOWS=18
NODE_BIRTH_GRACE_S=60
STORAGE_PERSISTENT_RESERVE_ENABLED=1
SS_ENABLED=1
MAX_DYNAMIC_STORAGE=8
MAX_DYNAMIC_COMPUTE=12
VIP_HARD_TIMEOUT=60

# -- Weights -- degradation_score (cross-signal confirmation) --
SCALEUP_W_CPU=0.40
SCALEUP_W_T_PROC=0.60
SCALEUP_W_STORAGE_CPU=0.20
SCALEUP_W_T_DB=0.80
