# RQ2 v5 campaign pins (D21/D21b) — merged on EVERY v5 run via the
# launcher's extra_env_file argument (v4 rq2v4_p4_pins.env precedent).
# Single source of truth: the merged env carries these to the controller
# process (=> dynamic edge spawns) and the launcher lifts them into the make
# vars (=> static edge docker -e). current_state_integrated.env is untouched.
# See docs/operation/testing/experiment/v5/rq2/rq2v5_plan.md S3.6.4.
STORAGE_POOL_RENEW_ENABLED=1
STORAGE_SELECTION_SPREAD_EPS=0.03
STORAGE_SELECTION_SPREAD_MIN_BAND=2
EDGE_POOL_RENEW_ENABLED=1
EDGE_POOL_RENEW_MIN_INTERVAL_S=15
EDGE_POOL_RENEW_WAVES=2
EDGE_POOL_RENEW_WAVE_GAP_S=45
# Seat-robustness delta (author-approved 2026-10-16): the db-class edge OOM
# (n1, ~245 MB RSS vs the 256m cap) killed edge_server_n1 in 2/2 stor@db pilots.
EDGE_MEMORY=384m
