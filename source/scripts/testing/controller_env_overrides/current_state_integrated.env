# Controller override for the current-state integrated baseline.
# G0-v4: median latency signals + COMPOSITE storage signal (validated 2026-08-03),
# WAN=185ms, 0.08/0.25 CPUs.
# 2026-08-01 control-group retune: caps lowered 8/12 -> 3/3 active dynamic per LAN
# and fast storage scale-down added (see docs/operation/testing/experiment/v2/control_group_retune/).
# 2026-08-03 control-group reset (median signal): ALL latency decision signals
# (scale-up + scale-down, compute + storage) use the window MEDIAN instead of the
# mean — the mean is right-skew-contaminated by single slow requests in low-volume
# windows. CPU signals stay mean (bounded 0-100%). Evidence + rationale:
# docs/operation/testing/experiment/v2/mean_vs_median_signal_finding.md.
# RQ1 runs are deliberately left mean-based (LATENCY_SIGNAL_MODE=mean) so archived
# RQ1 results stay byte-identical.
LATENCY_SIGNAL_MODE=median
STORAGE_PERSISTENT_RESERVE_ENABLED=1
SS_ENABLED=1
MAX_DYNAMIC_STORAGE=3
MAX_DYNAMIC_COMPUTE=3
SCALEUP_STORAGE_BASE_THRESHOLD=0.35
# Compute scale-up overrides — recalibrated for mean-only signal + tighter CPUs
SCALEUP_COMPUTE_BASE_THRESHOLD=0.18
SCALEUP_CPU_FLOOR=10
SCALEUP_CPU_SPAN=40
SCALEUP_T_PROC_FLOOR=25
SCALEUP_W_CPU=0.60
SCALEUP_W_T_PROC=0.40
# Compute scale-down overrides (longer grace to sustain nodes)
SCALEDOWN_COMPUTE_COOLDOWN_S=180
SCALE_DOWN_COMPUTE_REQUIRED=9
# Storage scale-down overrides (fast reclaim - control-group retune 2026-08-01)
# 30s cooldown + 3/5 windows ~= 80s per removal; reserve-floor decoupled when
# >2 dynamic nodes -> back-to-back removal within demand_drop.
SCALEDOWN_STORAGE_COOLDOWN_S=30
SCALE_DOWN_STORAGE_WINDOW_SIZE=5
SCALE_DOWN_STORAGE_REQUIRED=3
# Storage scale-up — COMPOSITE signal (G0-v4, validated 2026-08-03): storage
# CPU (bounded 0-100%, robust) + median DB latency. Weights 0.60/0.40, CPU floor
# 10 / span 30, latency 10/50 (crossing = 10 + 0.35*50 = 27.5 ms). The
# pure-latency median under-provisioned storage in the plateau (concurrent 2.0,
# 12-17% error vs mean-era 1.31%) because its plateau/demand_drop range is only
# ~1.4 ms; storage CPU differentiates cleanly (plateau p50 44-47% vs demand_drop
# ~18%) and the composite reproduces the mean-era envelope (2.0% error, 3.0
# concurrent — validated cgr_v3_scalable). Scale-down is CPU-aware: below =
# stCpu<22 AND med_db<8 — plateau (stCpu 30-44) protected, demand_drop (~18)
# reclaims.
SCALEUP_W_STORAGE_CPU=0.60
SCALEUP_W_T_DB=0.40
SCALEUP_STORAGE_CPU_FLOOR=10
SCALEUP_STORAGE_CPU_SPAN=30
SCALEUP_T_DB_FLOOR=10
SCALEUP_T_DB_SPAN=50
TAU_DB_DOWN_MS=8
STORAGE_SCALE_DOWN_CPU_AWARE=1
TAU_STORAGE_CPU_DOWN=22
SCALEUP_STORAGE_REQUIRED=2
SCALEUP_STORAGE_WINDOW_SIZE=5
SCALEUP_STORAGE_COOLDOWN_S=120
VIP_HARD_TIMEOUT=60
# 2026-08-03 data-path fix: EDGE_MONGO_READ_PREFERENCE=secondaryPreferred makes
# storage secondaries serve reads (pre-fix: directConnection+primary-pref
# rejected reads on secondaries with NotPrimaryOrSecondary/13436, so storage
# scale-out produced ~zero usable read capacity). See
# docs/operation/testing/experiment/v2/read_preference_data_path_finding.md.
EDGE_MONGO_READ_PREFERENCE=secondaryPreferred
# 2026-08-03 Approach B (pooled fan-out): per-connection VIP_DATA forward rules
# keyed on tcp_src let a pooled edge client (EDGE_MONGO_MAX_POOL_SIZE>1) spread
# its connections across storage backends, so storage serving capacity scales
# with edges x pool. Static edges also need the shell var at setup_network;
# dynamic edges inherit via the controller env. See
# docs/operation/testing/experiment/v2/read_preference_data_path_finding.md.
VIP_DATA_PER_CONNECTION_FLOWS=1
EDGE_MONGO_MAX_POOL_SIZE=6
