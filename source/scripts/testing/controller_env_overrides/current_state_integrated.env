# Controller override for the current-state integrated baseline.
# G0-v2: mean-only latency signals, WAN=185ms, 0.08/0.25 CPUs.
# 2026-08-01 control-group retune: caps lowered 8/12 -> 3/3 active dynamic per LAN
# and fast storage scale-down added (see docs/operation/testing/experiment/v2/control_group_retune/).
STORAGE_PERSISTENT_RESERVE_ENABLED=1
SS_ENABLED=1
MAX_DYNAMIC_STORAGE=3
MAX_DYNAMIC_COMPUTE=3
SCALEUP_STORAGE_BASE_THRESHOLD=0.35
# Compute scale-up overrides — recalibrated for mean-only signal + tighter CPUs
SCALEUP_COMPUTE_BASE_THRESHOLD=0.18
SCALEUP_CPU_FLOOR=10
SCALEUP_CPU_SPAN=40
SCALEUP_T_PROC_FLOOR=25
SCALEUP_W_CPU=0.60
SCALEUP_W_T_PROC=0.40
# Compute scale-down overrides (longer grace to sustain nodes)
SCALEDOWN_COMPUTE_COOLDOWN_S=180
SCALE_DOWN_COMPUTE_REQUIRED=9
# Storage scale-down overrides (fast reclaim - control-group retune 2026-08-01)
# 30s cooldown + 3/5 windows ~= 80s per removal; reserve-floor decoupled when
# >2 dynamic nodes -> back-to-back removal within demand_drop.
SCALEDOWN_STORAGE_COOLDOWN_S=30
SCALE_DOWN_STORAGE_WINDOW_SIZE=5
SCALE_DOWN_STORAGE_REQUIRED=3
# Storage scale-up — latency-only (W_STORAGE_CPU=0; CPU is I/O-bound at 0.08)
SCALEUP_W_STORAGE_CPU=0
SCALEUP_W_T_DB=1.0
SCALEUP_STORAGE_CPU_FLOOR=1.5
SCALEUP_STORAGE_CPU_SPAN=5
SCALEUP_T_DB_FLOOR=60
SCALEUP_T_DB_SPAN=250
SCALEUP_STORAGE_REQUIRED=2
SCALEUP_STORAGE_WINDOW_SIZE=5
SCALEUP_STORAGE_COOLDOWN_S=120
VIP_HARD_TIMEOUT=60
