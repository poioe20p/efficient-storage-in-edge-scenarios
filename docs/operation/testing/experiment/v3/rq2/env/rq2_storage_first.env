# RQ2 bottleneck-aware scaling campaign — Arm: fixed_storage_first.
# Regime: scale storage only, never compute. Rebased from the validated control
# group (current_state_integrated.env retune 2026-08-01) with Option B caps 6/6
# (strictly above the 4/tier/LAN budget so the budget binds, not the cap) and
# RQ2 scale-down calibration (compute
# 3-of-6 @ TAU 25/40; storage 30s + 3-of-5). Reserve/SS/cross-region disabled
# (thesis §2 / rq2_preparation D8). Unlisted knobs resolve from the base
# osken-controller.env. Consumed via OSKEN_ENV_OVERRIDE_FILE (run_matrix §4).
# 2026-08-03: LATENCY_SIGNAL_MODE=median (rebase on the control-group reset) —
# the controller's action-selection signal now agrees with the plan's G2
# bottleneck-validation median. See mean_vs_median_signal_finding.md.
# 2026-08-03 data-path fix: EDGE_MONGO_READ_PREFERENCE=secondaryPreferred makes
# storage secondaries serve reads (pre-fix: NotPrimaryOrSecondary/13436 on
# secondaries -> storage scale-out ~zero usable read capacity). Static edges
# also need the var on the shell at setup_network; dynamic edges inherit via
# the controller env. See read_preference_data_path_finding.md.
# 2026-08-03 Approach B (pooled fan-out): per-connection VIP_DATA flows +
# pooled edge client (48 conns/edge) so storage serving scales with edges x pool.
# Static edges need the shell vars at setup_network; dynamic inherit via env.
LATENCY_SIGNAL_MODE=median
EDGE_MONGO_READ_PREFERENCE=secondaryPreferred
VIP_DATA_PER_CONNECTION_FLOWS=1
EDGE_MONGO_MAX_POOL_SIZE=48
TELEMETRY_SOURCE=event_preserving
CONTROL_TICK_S=10
EVENT_POLL_INTERVAL_S=0.5
DELIVERY_LOG_PATH=/tmp/telemetry_delivery_log.csv
DECISION_LOG_PATH=/tmp/decision_log.csv
STORAGE_PERSISTENT_RESERVE_ENABLED=0
SS_ENABLED=0
CROSS_REGION_STORAGE_ENABLED=0
SCALEUP_POLICY=fixed_storage_first
ACTION_BUDGET_PER_TIER=4
BOTTLENECK_CLASSIFY_MARGIN=0.05
# ── caps (Option B: > budget so the 4/tier budget binds observably) ──
MAX_DYNAMIC_COMPUTE=6
MAX_DYNAMIC_STORAGE=6
# ── compute scale-up ──
SCALEUP_COMPUTE_BASE_THRESHOLD=0.18
SCALEUP_COMPUTE_THRESHOLD_INCREMENT=0.10
SCALEUP_COMPUTE_MAX_THRESHOLD=0.85
SCALEUP_W_CPU=0.60
SCALEUP_W_T_PROC=0.40
SCALEUP_CPU_FLOOR=10
SCALEUP_CPU_SPAN=40
SCALEUP_T_PROC_FLOOR=25
SCALEUP_T_PROC_SPAN=80
SCALEUP_WINDOW_SIZE=5
SCALEUP_REQUIRED=3
SCALEUP_COMPUTE_COOLDOWN_S=45
SCALEUP_COMPUTE_PEER_RELIEF=0.03
SCALEUP_COMPUTE_PEER_HEALTH_THRESHOLD=0.35
# ── storage scale-up (COMPOSITE — control-group G0-v4 rebase 2026-08-03) ──
SCALEUP_W_STORAGE_CPU=0.60
SCALEUP_W_T_DB=0.40
# RQ2 tuning 2026-08-03 (Option 2): CPU floor 10 -> 35 so compute-bound
# lifecycle CPU transients (29-31%) cannot trigger storage; data-bound is
# latency-dominated (tdb_med 500+ ms -> latency alone crosses 0.35) so it is
# unaffected. Residual compute-bound storage fires are latency-driven tail
# outliers (accepted, documented in run_matrix.md).
SCALEUP_STORAGE_CPU_FLOOR=35
SCALEUP_STORAGE_CPU_SPAN=30
SCALEUP_T_DB_FLOOR=10
SCALEUP_T_DB_SPAN=50
SCALEUP_STORAGE_BASE_THRESHOLD=0.35
SCALEUP_STORAGE_THRESHOLD_INCREMENT=0.10
SCALEUP_STORAGE_MIN_INCREMENT=0.05
SCALEUP_STORAGE_MAX_THRESHOLD=0.55
SCALEUP_STORAGE_WINDOW_SIZE=5
SCALEUP_STORAGE_REQUIRED=2
SCALEUP_STORAGE_COOLDOWN_S=120
# ── compute scale-down (RQ2/Q6 calibration: 3-of-6, relaxed below-criterion) ──
SCALEDOWN_COMPUTE_COOLDOWN_S=180
SCALE_DOWN_COMPUTE_WINDOW_SIZE=6
SCALE_DOWN_COMPUTE_REQUIRED=3
TAU_CPU_DOWN=25
TAU_PROC_DOWN_MS=40
# ── storage scale-down (control rebase: 30s + 3-of-5) ──
SCALEDOWN_STORAGE_COOLDOWN_S=30
SCALE_DOWN_STORAGE_WINDOW_SIZE=5
SCALE_DOWN_STORAGE_REQUIRED=3
# 2026-08-03 median-era re-anchor: TAU_DB_DOWN_MS 150 -> 8 + CPU-aware gate
# (STORAGE_SCALE_DOWN_CPU_AWARE=1, TAU_STORAGE_CPU_DOWN=22) — composite control
# rebase (see mean_vs_median_signal_finding.md §6).
TAU_DB_DOWN_MS=8
STORAGE_SCALE_DOWN_CPU_AWARE=1
TAU_STORAGE_CPU_DOWN=22
SCALE_DOWN_PROC_TIMEOUT_CEILING_MS=5000
SCALE_DOWN_DB_TIMEOUT_CEILING_MS=5000
SCALE_DOWN_CANDIDATE_MAX_STALENESS_S=90
# ── absent-node / heartbeat (RQ1 housekeeping) ──
TELEMETRY_TIMEOUT_WINDOWS=18
NODE_BIRTH_GRACE_S=60
# ── VIP (control rebase) ──
VIP_HARD_TIMEOUT=60
# ── RQ2 readiness admission gate (2026-08-06, ba_cb artifact mitigation) ──
# Admits a spawned compute backend into the VIP_SERVER pool only after it is
# actually serving: the edge emits `app_ready` after a real MongoDB ping OK
# AND the HTTP socket is bound (bind-delay fix), so admission can no longer
# precede servability (the ba_cb admission-window fast-fail source). Mirrors
# RQ3's direct-mode gate WITHOUT RQ3 measurement instrumentation:
# VIP_FLOW_ISOLATION / VIP_SERVER_PER_CONNECTION_FLOWS / EDGE_FLOW_ISOLATION
# stay unset (0) -> per-client D5 VIP_SERVER flows preserved. Env-only (no
# image rebuild): controller propagates EDGE_APP_READY_EVENT to dynamic
# spawns (compute_node_manager). See ba_cb_anomaly_claims.md decision (b).
READINESS_PROPAGATION=direct
EDGE_APP_READY_EVENT=1
READINESS_PROBE_TIMEOUT_S=5.0
READINESS_PROBE_MAX_S=120.0
READINESS_PROBE_RETRY_S=1.0
READINESS_EVENT_FALLBACK_S=5.0
EDGE_READY_PORT=5000
