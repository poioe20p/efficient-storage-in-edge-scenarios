# RQ3 saturation re-run — direct (event-driven) arm env override
# Distinct named regime (saturation: 48 clients / compute-heavy plateau),
# allowed by the canonical-env rule. Canonical:
# source/scripts/testing/controller_env_overrides/rq3sat_direct.env. See
# docs/operation/testing/experiment/v3/rq3/experiment_plan.md (campaign) and
# docs/operation/testing/experiment/rq3_saturation/experiment_plan.md (tuning).
# Based on rq3_direct.env; changes: MAX_DYNAMIC_COMPUTE 6 -> 12 (capacity
# headroom under 48-client load). CLIENTS / EDGE_CPUS / phases are launch
# parameters, not env vars.
STORAGE_PERSISTENT_RESERVE_ENABLED=0
SS_ENABLED=0
CROSS_REGION_STORAGE_ENABLED=0
TELEMETRY_SOURCE=event_preserving
SCALEUP_POLICY=dual
MAX_DYNAMIC_COMPUTE=12
# 48-client regime: Mongo pool 6 for dynamic edge servers (read from the
# controller env by compute_node_manager.py; static edges get it via the shell
# var at setup_network). v2 runs used pool 1 (6-client regime).
EDGE_MONGO_MAX_POOL_SIZE=6
READINESS_PROPAGATION=direct
READINESS_PROBE_TIMEOUT_S=5.0
READINESS_PROBE_MAX_S=120.0
READINESS_PROBE_RETRY_S=1.0
# Event-absence grace. Raised 5 -> 20 s after P-B: under 48-client load the
# bind stall reaches ~8-12 s (vs 2-5 s at lower load), exceeding 5 s and
# flipping ~44% of direct admissions to probe_fallback (event_fraction 0.562,
# instrumentation-degraded). The app_ready event ALWAYS arrives (100% of
# backends have app_ready_ts in P-A'/P-B) — just later — so the gate waits for
# it (admission still at event arrival; no timing change) and the direct arm
# stays 100% event-driven.
READINESS_EVENT_FALLBACK_S=20.0
DISCOVERY_POLL_INTERVAL_S=10.0
EDGE_READY_PORT=5000
ADMISSION_LOG_PATH=/tmp/admission_log.csv
VIP_FLOW_ISOLATION=1
VIP_SERVER_PER_CONNECTION_FLOWS=1
FLOW_ISOLATION_WARMUP_S=120.0
EDGE_APP_READY_EVENT=1
EDGE_FLOW_ISOLATION=1
BACKEND_SELECTION_POLICY=topology_host
VIP_WARM_SERVER_SECONDS=0
VIP_WARM_STORAGE_SECONDS=30
W_CPU=0.2
W_RAM=0.2
W_REQUESTS=0.2
W_HOPS=0.28
W_STORAGE_CPU=0.2
W_STORAGE_RAM=0.2
W_STORAGE_CONNECTIONS=0.1
W_STORAGE_LAG=0.2
W_STORAGE_HOPS=0.3
VIP_IDLE_TIMEOUT=30
VIP_HARD_TIMEOUT=120
CONTROL_TICK_S=10
DELAY_S=30
EVENT_POLL_INTERVAL_S=0.5
DELIVERY_LOG_PATH=/tmp/telemetry_delivery_log.csv
DECISION_LOG_PATH=/tmp/decision_log.csv
